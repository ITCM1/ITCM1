{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itcm1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itcm-global-ai",
      "database_id": "5343bfa30a4a88345600fff39ff36ce4"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
